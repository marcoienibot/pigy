{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pigy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  // A `fetch` of the Worker to a host of the zone that it is deployed on
  // goes the way of every other request from outside, through the front
  // door of that zone, with its firewall and Cloudflare Access. Without
  // the flag such a request goes straight to the origin of that host,
  // past both. pigy asks hosts that people name, for the card of a link
  // above all, and every host that it asks is a public one: see
  // packages/providers/src/host.ts.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "version_metadata": {
    "binding": "VERSION"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No "database_id": the first `wrangler deploy` creates a database
      // with this name and binds it, and later deploys keep that binding.
      "database_name": "pigy",
      // SQL generated by drizzle-kit from src/db/schema.ts.
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      // One object per workspace, named after the ID of the workspace.
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      // One object per sandbox workspace, named after its ID: the simulated
      // networks as that workspace sees them.
      { "name": "SIM_WORLD", "class_name": "SimWorldDO" }
    ]
  },
  // The history of the Durable Object classes, not of their data: the first
  // deploy creates both classes with SQLite storage. An entry that has been
  // deployed is never changed. Adding, renaming or deleting a class takes a
  // new entry with a new tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] },
    { "tag": "v2", "new_sqlite_classes": ["SimWorldDO"] }
  ],
  "workflows": [
    // One run per attempt at the delivery of a post to a channel. The
    // Durable Object of the workspace starts them.
    {
      "name": "pigy-publish",
      "binding": "PUBLISH",
      "class_name": "PublishWorkflow"
    }
  ],
  "ratelimits": [
    // How many requests one key of the public API may make: counted per
    // key, by its ID. The numbers are also in `apiRateLimit` of
    // packages/core, which is what the documentation says and what
    // `Retry-After` is made from: change both. The namespace is a number
    // of this account's own choosing, which no other limiter of the
    // account may share.
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "assets": {
    // No "directory": the Vite plugin in apps/web points it at the built
    // web app.
    "not_found_handling": "single-page-application",
    // Only these paths reach the Worker. Everything else is a static asset
    // or falls back to the app shell.
    "run_worker_first": ["/api/*", "/connect/*", "/sim/*", "/sync/*"]
  }
}

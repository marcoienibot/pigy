{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pigy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "version_metadata": {
    "binding": "VERSION"
  },
  "assets": {
    // No "directory": the Vite plugin in apps/web points it at the built
    // web app.
    "not_found_handling": "single-page-application",
    // Only these paths reach the Worker. Everything else is a static asset
    // or falls back to the app shell.
    "run_worker_first": ["/api/*"]
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pigy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  "version_metadata": {
    "binding": "VERSION"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // No "database_id": the first `wrangler deploy` creates a database
      // with this name and binds it, and later deploys keep that binding.
      "database_name": "pigy",
      // SQL generated by drizzle-kit from src/db/schema.ts.
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    // One object per workspace, named after the ID of the workspace.
    "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceDO" }]
  },
  // The history of the Durable Object classes, not of their data: the first
  // deploy creates WorkspaceDO with SQLite storage. An entry that has been
  // deployed is never changed. Renaming or deleting a class takes a new
  // entry with a new tag.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceDO"] }],
  "assets": {
    // No "directory": the Vite plugin in apps/web points it at the built
    // web app.
    "not_found_handling": "single-page-application",
    // Only these paths reach the Worker. Everything else is a static asset
    // or falls back to the app shell.
    "run_worker_first": ["/api/*", "/sim/*", "/sync/*"]
  }
}

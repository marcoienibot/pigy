# How long a browser may keep what Cloudflare serves of the web app. The
# rules are Cloudflare's: https://developers.cloudflare.com/workers/static-assets/headers/
# Without a rule, a file is kept and checked with the server before every
# use, which is right for index.html and for the icons.

# Vite names these files after their content, so one never changes under
# its name. A path here that has no file gets none of this: such a request
# goes to the Worker first, which answers it with a 404 that nothing keeps,
# `assetRoutes` in apps/worker/src/assets.ts.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# A new version of the app begins with these two. Said here and not left
# to the default, so that no rule above them ever makes them last.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

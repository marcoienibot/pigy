{
  "name": "pigy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @pigy/worker db:migrate && pnpm --filter @pigy/web dev",
    "build": "pnpm --filter @pigy/web build",
    "preview": "pnpm --filter @pigy/worker db:migrate && pnpm build && pnpm --filter @pigy/web preview",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @pigy/e2e e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7"
  }
}
